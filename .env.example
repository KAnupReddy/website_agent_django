#--------------------------------------------------------------------
# DJANGO
#--------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata

#--------------------------------------------------------------------
# DATABASE
#   DB_ENGINE = sqlite        → db.sqlite3 in the project folder (zero setup)
#   DB_ENGINE = mysql         → MySQL 8.4+ / MariaDB 10.11+
#   DB_ENGINE = mysql_legacy  → older servers, e.g. XAMPP's MariaDB 10.4
#--------------------------------------------------------------------
DB_ENGINE=mysql_legacy
DB_NAME=autobiz_ai_django
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Original CodeIgniter database (only used by: manage.py import_legacy)
LEGACY_DB_NAME=autobiz_ai
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306

#--------------------------------------------------------------------
# AI APIS  (leave OPENAI_API_KEY empty to use offline stub responses)
#--------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

#--------------------------------------------------------------------
# EMAIL (SMTP) — Outreach agent
#--------------------------------------------------------------------
EMAIL_FROM=
EMAIL_FROM_NAME=AutoBiz AI
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_CRYPTO=tls

#--------------------------------------------------------------------
# HOSTING / FTP — Hosting agent (empty FTP host = simulated upload)
#--------------------------------------------------------------------
HOSTING_BASE_DOMAIN=localhost
HOSTING_FTP_HOST=
HOSTING_FTP_USER=
HOSTING_FTP_PASS=
HOSTING_FTP_ROOT=/public_html/demos/

#--------------------------------------------------------------------
# APIFY (scraping — reserved, not used by the pipeline yet)
#--------------------------------------------------------------------
APIFY_API_TOKEN=
